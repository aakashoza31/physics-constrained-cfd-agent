# Copy to .env (git-ignored) or export these variables in your shell.

# Google Gemini API key. Required for the paper's agent runs
# (scripts/run_nozzle_feedback.py, scripts/run_nozzle_e2e.py,
# scripts/run_forward_step_2d.py), for --agent-backend gemini, and for
# paper/cfd_forge/scripts/controller_comparison.py and cube_llm_diagnosis.py.
# Replay and the deterministic demo backend need no key.
GEMINI_API_KEY=

# Model for all stages (the shared default is gemini-3.5-flash-lite, read via
# src/agents/llm_provenance.py). The paper's text calls used gemini-3.5-flash-lite;
# in the archived step sessions the field observer, which then had its own
# default, used gemini-3.6-flash.
GEMINI_MODEL=gemini-3.5-flash-lite

# WSL distribution and OpenFOAM Foundation v14 environment used for case
# execution (src/openfoam/executor.py, src/pipeline/foam_runtime.py,
# src/cfd/diagnostics.py).
OPENFOAM_WSL_DISTRO=Ubuntu-24.04
OPENFOAM_BASHRC=/opt/openfoam14/etc/bashrc

# WSL distribution used to launch ParaView for field-evolution videos
# (src/reporting/field_video.py) and the airfoil CGNS reader
# (src/pipeline/airfoil/cgns.py). Usually the same as OPENFOAM_WSL_DISTRO.
CFD_WSL_DISTRO=Ubuntu-24.04

# Optional overrides for the field-video renderer and encoder.
# CFD_PVPYTHON=/usr/bin/pvpython
# CFD_FFMPEG=/usr/bin/ffmpeg
